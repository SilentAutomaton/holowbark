+
+func freeTCPPort(t *testing.T) int {
+	t.Helper()
+	l, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer l.Close()
+	return l.Addr().(*net.TCPAddr).Port
+}
+
+func peerIsUp(t *testing.T, y *Yggdrasil) bool {
+	t.Helper()
+	var peers []struct{ Up bool }
+	if err := json.Unmarshal([]byte(y.GetPeersJSON()), &peers); err != nil {
+		t.Fatal(err)
+	}
+	for _, p := range peers {
+		if p.Up {
+			return true
+		}
+	}
+	return false
+}
+
+func TestAddPeer_DialsAPeerOnARunningNode(t *testing.T) {
+	port := freeTCPPort(t)
+	server := &Yggdrasil{}
+	if err := server.StartJSON([]byte(fmt.Sprintf(`{"Listen":["tcp://127.0.0.1:%d"],"MulticastInterfaces":[]}`, port))); err != nil {
+		t.Fatal(err)
+	}
+	defer server.Stop()
+	client := &Yggdrasil{}
+	if err := client.StartJSON([]byte(`{"MulticastInterfaces":[]}`)); err != nil {
+		t.Fatal(err)
+	}
+	defer client.Stop()
+
+	if err := client.AddPeer(fmt.Sprintf("tcp://127.0.0.1:%d", port)); err != nil {
+		t.Fatal(err)
+	}
+	deadline := time.Now().Add(10 * time.Second)
+	for !peerIsUp(t, client) {
+		if time.Now().After(deadline) {
+			t.Fatal("the added peer did not come up")
+		}
+		time.Sleep(100 * time.Millisecond)
+	}
+}
+
+func TestAddPeer_NodeNotStarted_ReturnsAnError(t *testing.T) {
+	if err := (&Yggdrasil{}).AddPeer("tcp://127.0.0.1:1"); err == nil {
+		t.Fatal("expected an error")
+	}
+}
+
+type countingProtector struct{ calls atomic.Int32 }
+
+func (p *countingProtector) Protect(int) bool { p.calls.Add(1); return true }
+
+func TestSetProtector_PeerDialAsksItToProtectTheSocket(t *testing.T) {
+	port := freeTCPPort(t)
+	server := &Yggdrasil{}
+	if err := server.StartJSON([]byte(fmt.Sprintf(`{"Listen":["tcp://127.0.0.1:%d"],"MulticastInterfaces":[]}`, port))); err != nil {
+		t.Fatal(err)
+	}
+	defer server.Stop()
+	protector := &countingProtector{}
+	client := &Yggdrasil{}
+	client.SetProtector(protector)
+	defer client.SetProtector(nil)
+	if err := client.StartJSON([]byte(fmt.Sprintf(`{"Peers":["tcp://127.0.0.1:%d"],"MulticastInterfaces":[]}`, port))); err != nil {
+		t.Fatal(err)
+	}
+	defer client.Stop()
+
+	deadline := time.Now().Add(10 * time.Second)
+	for !peerIsUp(t, client) {
+		if time.Now().After(deadline) {
+			t.Fatal("the peer did not come up")
+		}
+		time.Sleep(100 * time.Millisecond)
+	}
+	if protector.calls.Load() == 0 {
+		t.Fatal("the protector was never asked")
+	}
+}
+
+func TestRemovePeer_ClosesTheLinkAndStopsRedialling(t *testing.T) {
+	port := freeTCPPort(t)
+	server := &Yggdrasil{}
+	if err := server.StartJSON([]byte(fmt.Sprintf(`{"Listen":["tcp://127.0.0.1:%d"],"MulticastInterfaces":[]}`, port))); err != nil {
+		t.Fatal(err)
+	}
+	defer server.Stop()
+	client := &Yggdrasil{}
+	if err := client.StartJSON([]byte(`{"MulticastInterfaces":[]}`)); err != nil {
+		t.Fatal(err)
+	}
+	defer client.Stop()
+	uri := fmt.Sprintf("tcp://127.0.0.1:%d", port)
+	if err := client.AddPeer(uri); err != nil {
+		t.Fatal(err)
+	}
+	waitPeer(t, client, true)
+
+	if err := client.RemovePeer(uri); err != nil {
+		t.Fatal(err)
+	}
+	waitPeer(t, client, false)
+	// A configured peer is redialled after about a second; a removed one is not.
+	time.Sleep(2500 * time.Millisecond)
+	if peerIsUp(t, client) {
+		t.Fatal("the removed peer was dialled again")
+	}
+}
+
+func TestRemovePeer_UnknownPeer_ReturnsAnError(t *testing.T) {
+	client := &Yggdrasil{}
+	if err := client.StartJSON([]byte(`{"MulticastInterfaces":[]}`)); err != nil {
+		t.Fatal(err)
+	}
+	defer client.Stop()
+	if err := client.RemovePeer("tcp://127.0.0.1:1"); err == nil {
+		t.Fatal("expected an error")
+	}
+}
+
+func TestRemovePeer_NodeNotStarted_ReturnsAnError(t *testing.T) {
+	if err := (&Yggdrasil{}).RemovePeer("tcp://127.0.0.1:1"); err == nil {
+		t.Fatal("expected an error")
+	}
+}
+
+func waitPeer(t *testing.T, y *Yggdrasil, up bool) {
+	t.Helper()
+	deadline := time.Now().Add(10 * time.Second)
+	for peerIsUp(t, y) != up {
+		if time.Now().After(deadline) {
+			t.Fatalf("the peer did not become up=%v", up)
+		}
+		time.Sleep(100 * time.Millisecond)
+	}
+}
