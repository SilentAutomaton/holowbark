+// Protector is implemented by the host to keep a socket out of a VPN. On Android
+// Protect is VpnService.protect: without it, a peer link dialled while the tunnel
+// is up would run through the tunnel it carries.
+type Protector interface {
+	Protect(fd int) bool
+}
+
+// SetProtector makes every outbound peer socket pass through p before it
+// connects, and a socket p refuses is not connected. Call it before StartJSON.
+func (m *Yggdrasil) SetProtector(p Protector) {
+	if p == nil {
+		core.SocketProtector = nil
+		return
+	}
+	core.SocketProtector = func(fd uintptr) bool { return p.Protect(int(fd)) }
+}
+
+// AddPeer dials a peer on a running node and redials it when the link drops, as
+// an entry of Peers in the config does. uri is the peer URI, e.g. tls://host:443.
+func (m *Yggdrasil) AddPeer(uri string) error {
+	if m.core == nil {
+		return errors.New("the node is not running")
+	}
+	u, err := url.Parse(uri)
+	if err != nil {
+		return err
+	}
+	return m.core.AddPeer(u, "")
+}
+
+// RemovePeer closes the link to a peer and stops redialling it. uri is the form
+// AddPeer or the config took. A peer that is not configured is an error.
+func (m *Yggdrasil) RemovePeer(uri string) error {
+	if m.core == nil {
+		return errors.New("the node is not running")
+	}
+	u, err := url.Parse(uri)
+	if err != nil {
+		return err
+	}
+	return m.core.RemovePeer(u, "")
+}
+
 // Retry resets the peer connection timer and tries to dial them immediately.
 func (m *Yggdrasil) RetryPeersNow() {
 	m.core.RetryPeersNow()
