+// KeyForAddress returns the public key the node has learned for addr, or nil if
+// it has not seen traffic from it yet. The key is what core.WriteTo needs, so a
+// caller that keeps it can address the node directly instead of waiting for the
+// lookup that sendToAddress falls back to — which matters after the entry has
+// expired, not only on the first packet.
+func (rwc *ReadWriteCloser) KeyForAddress(addr address.Address) ed25519.PublicKey {
+	rwc.mutex.Lock()
+	defer rwc.mutex.Unlock()
+	info := rwc.addrToInfo[addr]
+	if info == nil {
+		return nil
+	}
+	return ed25519.PublicKey(append([]byte(nil), info.key[:]...))
+}
