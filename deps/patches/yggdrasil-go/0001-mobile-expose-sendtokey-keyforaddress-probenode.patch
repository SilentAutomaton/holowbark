+// ProbeNode asks the node with the given public key for its nodeinfo and calls
+// back when the answer arrives. Nodeinfo rides the proto layer, which needs no
+// established session, so this answers "is that node reachable through the
+// mesh at all" without first waiting for a session to come up.
+func (c *Core) ProbeNode(key []byte, callback func(json.RawMessage)) error {
+	if len(key) != ed25519.PublicKeySize {
+		return fmt.Errorf("invalid public key length")
+	}
+	var kb keyArray
+	copy(kb[:], key)
+	c.proto.nodeinfo.sendReq(nil, kb, callback)
+	return nil
+}
