+// SendToKey sends a fully formed IPv6 packet to the node with the given public
+// key (64 hex chars), skipping the address-to-key lookup that Send relies on.
+// That lookup buffers a single packet while it runs and its result expires after
+// two minutes of silence, so an idle tunnel stalls on the packet that wakes it.
+// A caller that already knows the key does not pay for either.
+func (m *Yggdrasil) SendToKey(p []byte, peerKeyHex string) error {
+	if m.core == nil {
+		return nil
+	}
+	key, err := hex.DecodeString(peerKeyHex)
+	if err != nil || len(key) != ed25519.PublicKeySize {
+		return nil
+	}
+	_, _ = m.core.WriteTo(p, iwt.Addr(key))
+	return nil
+}
+
+// KeyForAddress returns the public key (64 hex chars) this node has learned for
+// the given overlay address, or "" while it has not heard from it. The address
+// is a truncated hash of the key, so this is the only way back to the key.
+func (m *Yggdrasil) KeyForAddress(addrStr string) string {
+	if m.iprwc == nil {
+		return ""
+	}
+	ip := net.ParseIP(addrStr)
+	if ip == nil {
+		return ""
+	}
+	ip = ip.To16()
+	if ip == nil {
+		return ""
+	}
+	var addr address.Address
+	copy(addr[:], ip)
+	key := m.iprwc.KeyForAddress(addr)
+	if key == nil {
+		return ""
+	}
+	return hex.EncodeToString(key)
+}
+
+// ProbeNode reports whether the node with the given public key answers a
+// nodeinfo request within timeoutMs. Nodeinfo needs no established session, so
+// this separates "the mesh cannot reach that node" from "the node is there but
+// the tunnel through it is down".
+func (m *Yggdrasil) ProbeNode(peerKeyHex string, timeoutMs int64) bool {
+	if m.core == nil {
+		return false
+	}
+	key, err := hex.DecodeString(peerKeyHex)
+	if err != nil || len(key) != ed25519.PublicKeySize {
+		return false
+	}
+	answered := make(chan struct{}, 1)
+	if err := m.core.ProbeNode(key, func(json.RawMessage) {
+		select {
+		case answered <- struct{}{}:
+		default:
+		}
+	}); err != nil {
+		return false
+	}
+	timer := time.NewTimer(time.Duration(timeoutMs) * time.Millisecond)
+	defer timer.Stop()
+	select {
+	case <-answered:
+		return true
+	case <-timer.C:
+		return false
+	}
+}
+
