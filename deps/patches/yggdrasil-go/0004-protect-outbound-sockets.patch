new file mode 100644
index 0000000..d0da1dc
--- /dev/null
+++ b/src/core/protect.go
@@ -0,0 +1,34 @@
+package core
+
+import (
+	"errors"
+	"syscall"
+)
+
+// SocketProtector, when set, is called with the descriptor of every outbound
+// socket before it connects. On Android it keeps the socket out of a VPN whose
+// tunnel the peer link itself carries. Set it before a node starts.
+var SocketProtector func(fd uintptr) bool
+
+var errSocketProtect = errors.New("the socket protector refused the descriptor")
+
+// protectControl wraps a net.Dialer or net.ListenConfig Control function. A
+// refused socket aborts the dial: connecting it anyway would send the link into
+// the tunnel it is meant to carry.
+func protectControl(next func(network, address string, c syscall.RawConn) error) func(network, address string, c syscall.RawConn) error {
+	return func(network, address string, c syscall.RawConn) error {
+		if protect := SocketProtector; protect != nil {
+			var ok bool
+			if err := c.Control(func(fd uintptr) { ok = protect(fd) }); err != nil {
+				return err
+			}
+			if !ok {
+				return errSocketProtect
+			}
+		}
+		if next == nil {
+			return nil
+		}
+		return next(network, address, c)
+	}
+}
