+package core
+
+import (
+	"context"
+	"crypto/tls"
+	"net"
+	"net/url"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/quic-go/quic-go"
+	"github.com/yggdrasil-network/yggdrasil-go/src/config"
+)
+
+func setProtector(t *testing.T, protect func(fd uintptr) bool) {
+	t.Helper()
+	SocketProtector = protect
+	t.Cleanup(func() { SocketProtector = nil })
+}
+
+func newTestCore(t *testing.T) (*Core, *config.NodeConfig) {
+	t.Helper()
+	cfg := config.GenerateConfig()
+	require_NoError(t, cfg.GenerateSelfSignedCertificate())
+	core, err := New(cfg.Certificate, GetLoggerWithPrefix("", false))
+	require_NoError(t, err)
+	t.Cleanup(core.Stop)
+	return core, cfg
+}
+
+func dialTCP(t *testing.T, core *Core) error {
+	t.Helper()
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	require_NoError(t, err)
+	defer listener.Close()
+	u, err := url.Parse("tcp://" + listener.Addr().String())
+	require_NoError(t, err)
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	conn, err := core.links.tcp.dial(ctx, u, linkInfo{}, linkOptions{})
+	if err == nil {
+		conn.Close()
+	}
+	return err
+}
+
+func dialQUIC(t *testing.T, core *Core, cfg *config.NodeConfig) error {
+	t.Helper()
+	listener, err := quic.ListenAddr("127.0.0.1:0", &tls.Config{
+		Certificates: []tls.Certificate{*cfg.Certificate},
+		MinVersion:   tls.VersionTLS13,
+	}, &quic.Config{})
+	require_NoError(t, err)
+	defer listener.Close()
+	ctx, cancel := context.WithTimeout(context.Background(), 30*time.Second)
+	defer cancel()
+	go func() {
+		if conn, err := listener.Accept(ctx); err == nil {
+			defer conn.CloseWithError(0, "")
+			<-ctx.Done()
+		}
+	}()
+	u, err := url.Parse("quic://" + listener.Addr().String())
+	require_NoError(t, err)
+	// The first QUIC handshake of a process can exceed the 5 s handshake timeout
+	// on a loaded host, so a failed dial is retried.
+	var conn net.Conn
+	for attempt := 0; attempt < 3; attempt++ {
+		if conn, err = core.links.quic.dial(ctx, u, linkInfo{}, linkOptions{}); err == nil {
+			conn.Close()
+			return nil
+		}
+	}
+	return err
+}
+
+func TestSocketProtector_TCPDialCallsItOnce(t *testing.T) {
+	var calls atomic.Int32
+	setProtector(t, func(uintptr) bool { calls.Add(1); return true })
+	core, _ := newTestCore(t)
+	require_NoError(t, dialTCP(t, core))
+	require_Equal(t, calls.Load(), int32(1))
+}
+
+func TestSocketProtector_QUICDialCallsItOnce(t *testing.T) {
+	var calls atomic.Int32
+	setProtector(t, func(uintptr) bool { calls.Add(1); return true })
+	core, cfg := newTestCore(t)
+	require_NoError(t, dialQUIC(t, core, cfg))
+	require_Equal(t, calls.Load(), int32(1))
+}
+
+func TestSocketProtector_RefusalFailsTheTCPDial(t *testing.T) {
+	setProtector(t, func(uintptr) bool { return false })
+	core, _ := newTestCore(t)
+	require_True(t, dialTCP(t, core) != nil)
+}
+
+func TestSocketProtector_RefusalFailsTheQUICDial(t *testing.T) {
+	setProtector(t, func(uintptr) bool { return false })
+	core, cfg := newTestCore(t)
+	require_True(t, dialQUIC(t, core, cfg) != nil)
+}
